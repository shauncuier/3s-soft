# Generated by scripts/build-htaccess.ts from src/content/redirects.ts. Do not edit by hand.
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # www goes to the bare production domain
  RewriteCond %{HTTP_HOST} ^www\.3s-soft\.com$ [NC]
  RewriteRule ^ https://3s-soft.com%{REQUEST_URI} [L,R=301]
  # HTTPS on whatever host was asked for, so a staging subdomain stays on staging
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Folder URLs end with a slash (matches trailingSlash: true in the build)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]
</IfModule>

# Permanent redirects for removed and moved pages
RedirectMatch 301 ^/services/digital-marketing-seo/?$ /services/ecommerce-product-listing/
RedirectMatch 301 ^/services/graphic-design/?$ /services/amazon-a-plus-content/
RedirectMatch 301 ^/services/social-media-marketing/?$ /services/
RedirectMatch 301 ^/services/web-development-mern/?$ https://3s-soft.net/services/
RedirectMatch 301 ^/services/wordpress-customization/?$ https://3s-soft.net/services/
RedirectMatch 301 ^/portfolio/ecommerce-platform-retailmax/?$ /portfolio/
RedirectMatch 301 ^/portfolio/business-analytics-dashboard-datadriven/?$ /portfolio/
RedirectMatch 301 ^/portfolio/healthcare-portal-medicare/?$ /portfolio/
RedirectMatch 301 ^/portfolio/real-estate-platform-propertyhub/?$ /portfolio/
RedirectMatch 301 ^/portfolio/restaurant-chain-website-tastybites/?$ /portfolio/
RedirectMatch 301 ^/portfolio/fashion-brand-store-stylevogue/?$ /portfolio/
RedirectMatch 301 ^/portfolio/fitness-tracking-app-fitlife/?$ /portfolio/
RedirectMatch 301 ^/portfolio/corporate-branding-suite-techventure/?$ /portfolio/
RedirectMatch 301 ^/portfolio/amazon-marketplace-optimization-homegoods/?$ /portfolio/
RedirectMatch 301 ^/portfolio/seo-digital-marketing-greenenergy/?$ /portfolio/
RedirectMatch 301 ^/portfolio/social-media-campaign-luxe-beauty/?$ /portfolio/
RedirectMatch 301 ^/portfolio/educational-learning-platform-edutech/?$ /portfolio/
RedirectMatch 301 ^/blog/mern-stack-scalable-web-applications-2026/?$ https://3s-soft.net/
RedirectMatch 301 ^/blog/wordpress-security-best-practices-2026/?$ https://3s-soft.net/
RedirectMatch 301 ^/blog/ai-powered-web-development-next-frontier/?$ https://3s-soft.net/
RedirectMatch 301 ^/blog/advanced-seo-audit-checklist-uk/?$ /services/ecommerce-product-listing/
RedirectMatch 301 ^/blog/digital-transformation-roadmap-2026/?$ /services/
RedirectMatch 301 ^/blog/full-stack-digital-marketing-roi/?$ /services/
RedirectMatch 301 ^/blog/3s-soft-engineering-advantage-global-success/?$ /about-us/
RedirectMatch 301 ^/blog/best-software-company-in-chittagong-3s-soft/?$ /about-us/
RedirectMatch 301 ^/blog/b2b-lead-generation-virtual-assistants-roi/?$ /services/lead-generation/
RedirectMatch 301 ^/login/?$ /contact/
RedirectMatch 301 ^/register/?$ /contact/
RedirectMatch 301 ^/dashboard(/.*)?$ /
RedirectMatch 301 ^/blog/?$ /blogs/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<Files "sitemap.xml">
  ForceType application/xml
</Files>
